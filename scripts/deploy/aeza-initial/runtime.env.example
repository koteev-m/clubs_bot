# TEMPLATE ONLY. Operator supplies .env (0600), never commit actual values.
# Only linux/amd64 or linux/arm64, after independently identifying target host.
CLB_PLATFORM=
# PostgreSQL 16 official image digest for that platform; no tag fallback.
CLB_PG_IMAGE=
# Signed/provenance-verified GHCR digest; image must carry matching OCI revision.
CLB_APP_IMAGE=
CLB_REVISION=
# Separate secrets/postgres_password is DB admin; never passed to app.
CLB_DB_PASSWORD=
CLB_BOT_TOKEN=
CLB_WEBHOOK_SECRET=
CLB_OWNER_ID=
# Operator-confirmed chat IDs, private like the other runtime inputs.
# Signed decimal Long: optional +/- and 1..19 ASCII digits, within int64 range.
# Zero placeholders are refused; disabled integrations do not prove them safe.
CLB_HQ_CHAT_ID=
CLB_CLUB1_CHAT_ID=
CLB_CLUB2_CHAT_ID=
CLB_CLUB3_CHAT_ID=
CLB_CLUB4_CHAT_ID=
CLB_QR_SECRET=
CLB_PHONE_KEY=
